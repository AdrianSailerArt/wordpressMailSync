{
  "name": "wordpress-mail-sync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Liest Musik-Pressemitteilungen aus einem IMAP-Postfach, schreibt sie per Claude SEO-gerecht um und veröffentlicht sie in WordPress – mit Vue-Dashboard.",
  "scripts": {
    "dev": "bun run dev:server & bun run dev:web",
    "dev:server": "bun run --watch server/index.ts",
    "dev:web": "bunx --bun vite web",
    "build": "bunx --bun vite build web",
    "start": "bun run build && bun run serve",
    "serve": "bun run server/index.ts",
    "once": "bun run server/cli.ts",
    "typecheck": "tsc --noEmit -p . && vue-tsc --noEmit -p web",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "croner": "^11.0.0",
    "hono": "^4.13.16",
    "html-to-text": "^10.0.1",
    "image-size": "^2.0.4",
    "imapflow": "^2.10.0",
    "mailparser": "^3.14.1",
    "sanitize-html": "^2.18.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-vue": "^6.0.10",
    "diff": "^9.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.14"
  }
}
