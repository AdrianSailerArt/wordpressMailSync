# --- IMAP ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=presse@example.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Optional: verarbeitete Mails in diesen Ordner verschieben (sonst nur IMAP-Keyword setzen)
IMAP_PROCESSED_FOLDER=
# Nur Mails der letzten N Tage berücksichtigen
MAX_AGE_DAYS=7

# --- WordPress (Benutzer -> Profil -> Anwendungspasswörter) ---
WP_URL=https://www.example.com
WP_USER=pressbot
WP_APP_PASSWORD=
# publish | draft | pending
WP_STATUS=publish
# Erlaubte Kategorien (Claude wählt eine davon, fehlende werden angelegt)
WP_CATEGORIES=News,Tourdaten,Releases,Festivals
# yoast | rankmath | none  (siehe wordpress/pressbot-seo-meta.php)
SEO_PLUGIN=yoast
# Erstes Bild-Attachment der Mail als Beitragsbild hochladen
FEATURED_IMAGE=true

# --- Limits & Zeitplan ---
DAILY_LIMIT=3
POSTS_PER_RUN=1
TIMEZONE=Europe/Berlin
# Cron-Ausdruck für automatische Läufe (Standard: 8, 13 und 18 Uhr)
SCHEDULE=0 8,13,18 * * *

# --- Dashboard ---
HOST=127.0.0.1
PORT=3210
# Pflicht, sobald das Dashboard aus dem Internet erreichbar ist (Benutzername: admin)
DASHBOARD_PASSWORD=
DB_PATH=data/pressbot.sqlite

# --- Sprachmodell ---
# ollama = lokal & kostenlos (Ollama-App muss laufen) | claude = Claude-API (braucht API-Key)
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Modell vorher laden:  ollama pull gemma4
OLLAMA_MODEL=gemma4
# Nur für LLM_PROVIDER=claude:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

SITE_NAME=Mein Musikblog
# Kurze Beschreibung von Ton/Zielgruppe deines Blogs
SITE_TONE=locker, kompetent, für Konzertgänger im deutschsprachigen Raum
