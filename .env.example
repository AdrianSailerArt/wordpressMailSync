# --- IMAP ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=presse@example.com
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Optional: verarbeitete Mails in diesen Ordner verschieben (sonst nur IMAP-Keyword setzen)
IMAP_PROCESSED_FOLDER=
# Optional: Anzeigename im Dashboard (Standard: IMAP_USER)
IMAP_NAME=

# Weitere Postfächer: IMAP_2_*, IMAP_3_* … (bis 9). Fehlen HOST/PORT/FOLDER, gelten die Werte von oben.
# Dieselbe Mail in mehreren Postfächern wird erkannt und nur einmal angezeigt und verarbeitet.
# IMAP_2_USER=redaktion@example.com
# IMAP_2_PASSWORD=
# IMAP_2_HOST=
# IMAP_2_NAME=Redaktion
# Nur Mails der letzten N Tage berücksichtigen
MAX_AGE_DAYS=7

# --- WordPress (Benutzer -> Profil -> Anwendungspasswörter) ---
WP_URL=https://www.example.com
WP_USER=pressbot
WP_APP_PASSWORD=
# publish | draft | pending
WP_STATUS=publish
# Kategorien als Anzeigename=WordPress-Slug (das Modell wählt eine davon).
# Ohne "=slug" wird die Kategorie über den Namen gesucht bzw. angelegt.
WP_CATEGORIES=News=music-news,Events=events
# yoast | rankmath | none  (siehe wordpress/pressbot-seo-meta.php)
SEO_PLUGIN=yoast
# Größtes Bild der Mail automatisch als Beitragsbild (im Dashboard änderbar)
FEATURED_IMAGE=true

# --- Limits & Zeitplan ---
# Richtwert: so viele Beiträge veröffentlicht der Zeitplan höchstens pro Tag; manuell geht mehr
DAILY_LIMIT=3
POSTS_PER_RUN=1
TIMEZONE=Europe/Berlin
# Automatisch veröffentlichen (Standard: 8, 13 und 18 Uhr) – false = nur Vorschläge, du veröffentlichst selbst
AUTO_PUBLISH=true
SCHEDULE=0 8,13,18 * * *
# Automatische Vorschläge mit Chrome-Benachrichtigung (Standard: 10× täglich)
SUGGEST_SCHEDULE=0 8,9,11,12,14,15,17,18,20,21 * * *

# --- Dashboard ---
HOST=127.0.0.1
PORT=3210
# Pflicht, sobald das Dashboard aus dem Internet erreichbar ist (Benutzername: admin)
DASHBOARD_PASSWORD=
DB_PATH=data/pressbot.sqlite

# --- Sprachmodell ---
# ollama = lokal & kostenlos (Ollama-App muss laufen) | claude = Claude-API (braucht API-Key)
LLM_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
# Modell vorher laden:  ollama pull gemma4
OLLAMA_MODEL=gemma4
# Nur für LLM_PROVIDER=claude:
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Stil-Regelwerk der Redaktion (Markdown), wird jedem Schreibauftrag mitgegeben
STYLE_FILE=stil/regelwerk.md

SITE_NAME=Mein Musikblog
# Kurze Beschreibung von Ton/Zielgruppe deines Blogs
SITE_TONE=locker, kompetent, für Konzertgänger im deutschsprachigen Raum

# --- Konzertkalender (WordPress-Plugin wordpress/konzertkalender) ---
# Quellen und Gebiet
KALENDER_FILE=kalender/quellen.json
# kostenloser Schlüssel von developer.ticketmaster.com („Consumer Key“) – leer lassen, um Ticketmaster auszulassen
TICKETMASTER_API_KEY=
# neue Termine sofort zeigen (publish) oder erst prüfen (draft)
KALENDER_STATUS=publish
# täglich automatisch abrufen (der Mac muss an sein)
KALENDER_AUTO=false
KALENDER_SCHEDULE=30 6 * * *
